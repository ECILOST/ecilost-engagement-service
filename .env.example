PORT=3005
DATABASE_URL=postgresql://engagement:engagement@localhost:5437/ecilost_engagement?schema=public
RABBITMQ_URL=amqp://ecilost:ecilost@localhost:5672
AUTH_JWKS_URL=http://localhost:3000/.well-known/jwks.json
JWT_ISSUER=https://auth.ecilost.local
JWT_AUDIENCE=ecilost-services
# Auction, para confirmar que una sala existe y que quien pide escucharla puede verla (room.join).
AUCTION_SERVICE_URL=http://localhost:3003
# Gamificacion (perfil, top semanal, medallas): modelo de lectura en MongoDB Atlas.
# Sin MONGODB_URI engagement arranca igual y /profiles/me y /leaderboard responden 503.
# La base y las colecciones las crea el servicio (Mongo las crea al primer insert y los
# indices se aseguran al conectar). Nunca subas la URI real con la contraseña.
MONGODB_URI=
MONGODB_DB=ecilost_engagement
