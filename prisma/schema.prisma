generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum NotificationKind {
  OUTBID
  ROUND_CLOSED
}

model ConsumedEvent {
  eventId     String   @id
  eventType   String
  payload     Json
  occurredAt  DateTime
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  attempts    Int      @default(0)
  lastError   String?

  @@index([processedAt, receivedAt])
  @@map("consumed_events")
}

model Notification {
  id          String           @id
  eventId     String           @unique
  kind        NotificationKind
  roomId      String
  recipientId String?
  payload     Json
  createdAt   DateTime         @default(now())

  @@index([recipientId, createdAt])
  @@index([roomId, createdAt])
  @@map("notifications")
}
