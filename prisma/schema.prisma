generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum NotificationKind {
  OUTBID
  ROUND_CLOSED
  ROUND_WON
  PICKUP_READY
}

model ConsumedEvent {
  eventId     String   @id
  eventType   String
  // Sala del evento, fuera del JSON para leer la actividad de una sala sin recorrer la tabla.
  roomId      String?
  payload     Json
  occurredAt  DateTime
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  attempts    Int      @default(0)
  lastError   String?

  @@index([processedAt, receivedAt])
  @@index([roomId, occurredAt])
  @@map("consumed_events")
}

model Notification {
  id          String           @id
  // Un evento puede producir varias notificaciones (el cierre avisa a la sala y al ganador),
  // pero nunca dos del mismo tipo: esa es la llave que hace idempotente reprocesarlo.
  eventId     String
  kind        NotificationKind
  roomId      String
  recipientId String?
  payload     Json
  createdAt   DateTime         @default(now())
  readAt      DateTime?

  @@unique([eventId, kind])
  @@index([recipientId, createdAt])
  @@index([roomId, createdAt])
  @@map("notifications")
}

// Chat de la sala en curso: solo escriben los admitidos antes del inicio. El autor se guarda
// para limitar el envio y calcular su alias; a la sala nunca se le publica su userId.
model ChatMessage {
  id        String   @id
  roomId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

enum PickupStatus {
  PENDING
  BOOKED
  NEEDS_HELP
  DELIVERED
}

model PickupSlot {
  id        String   @id @default(uuid())
  location  String
  startsAt  DateTime
  endsAt    DateTime
  capacity  Int
  pickups   AuctionPickup[]

  @@unique([location, startsAt, endsAt])
  @@index([startsAt])
  @@map("pickup_slots")
}

model AuctionPickup {
  roundId        String       @id
  roomId         String
  entries        Json         @default("[]")
  messages       PickupMessage[]
  winnerId       String
  status         PickupStatus @default(PENDING)
  slotId         String?
  slot           PickupSlot?  @relation(fields: [slotId], references: [id], onDelete: Restrict)
  deliveryCodeHash String?
  deliveredAt    DateTime?
  deliveredBy    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([winnerId, createdAt])
  @@index([slotId, status])
  @@map("auction_pickups")
}

model PickupMessage {
  id        String        @id @default(uuid())
  roundId   String
  pickup    AuctionPickup @relation(fields: [roundId], references: [roundId], onDelete: Cascade)
  author    String
  body      String
  createdAt DateTime      @default(now())

  @@index([roundId, createdAt])
  @@map("pickup_messages")
}
