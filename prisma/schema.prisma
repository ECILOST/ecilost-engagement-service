generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum NotificationKind {
  OUTBID
  ROUND_CLOSED
  ROUND_WON
}

model ConsumedEvent {
  eventId     String   @id
  eventType   String
  payload     Json
  occurredAt  DateTime
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  attempts    Int      @default(0)
  lastError   String?

  @@index([processedAt, receivedAt])
  @@map("consumed_events")
}

model Notification {
  id          String           @id
  // Un evento puede producir varias notificaciones (el cierre avisa a la sala y al ganador),
  // pero nunca dos del mismo tipo: esa es la llave que hace idempotente reprocesarlo.
  eventId     String
  kind        NotificationKind
  roomId      String
  recipientId String?
  payload     Json
  createdAt   DateTime         @default(now())
  readAt      DateTime?

  @@unique([eventId, kind])
  @@index([recipientId, createdAt])
  @@index([roomId, createdAt])
  @@map("notifications")
}
